# The harbor's settings: `onogoro harbor --help` says each. Readable by the harbor user only.

# The ConoHa API user (control panel → API). The same names GMO's MCP server uses.
OPENSTACK_TENANT_ID=
OPENSTACK_USER_ID=
OPENSTACK_PASSWORD=
CONOHA_REGION=c3j1

# What a server is made from: an image id (GET image-service /v2/images), the boot volume
# type (GET block-storage /types), and the SSH key pair a person gets in with.
ONOGORO_HARBOR_IMAGE=
ONOGORO_HARBOR_VOLUME_TYPE=
ONOGORO_HARBOR_KEY_NAME=
ONOGORO_HARBOR_SECURITY_GROUP=

# The limits. Prices change (ConoHa revised them on 2026-07-01): take each plan's monthly
# cap from https://vps.conoha.jp/pricing/ and the flavor names from GET /flavors.
ONOGORO_HARBOR_PLANS=
ONOGORO_HARBOR_MAX_SERVERS=1
ONOGORO_HARBOR_YEN_MONTH=0
ONOGORO_HARBOR_PREFIX=staff-
ONOGORO_HARBOR_STOPPED_BILLED=true
