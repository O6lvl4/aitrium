// onogoro — a world for coding agents: the agent's tools run confined by porta, one call at
// a time, and the keys stay outside with the agent.
//
// One binary, two roles. Run by a person, it is the supervisor: it starts comide with
// itself as comide's runner (--runner), and comide keeps the keys and the conversation.
// Run by comide for a tool's command (`onogoro KIND -- PROG ARGS`, with ONOGORO_ROLE set),
// it is a worker: it runs that command inside porta with the grants policy.almd gives
// the call, and nothing of the supervisor's environment but what those grants pass.

import env
import fs
import process
import self.policy

let USAGE = """
onogoro [comide's arguments]      comide, with every tool's command confined by porta

  ONOGORO_COMIDE   the comide binary (default: comide on PATH)
  ONOGORO_PORTA    the porta binary (default: porta on PATH)
  ONOGORO_NET      open (default) or none: the network for commands and golemide
  ONOGORO_KEYS     the variables golemide is given for its own model calls, comma
                   separated (default: every model key that is set)
  ONOGORO_BRIDGE   the Claude bridge (default: bridge/claude_bridge.py beside onogoro)
  ONOGORO_CREDENTIALS  broker (default) or by-name. broker: golemide's model keys go in as
                   porta placeholders bound to the model's host, and porta's proxy puts the
                   real key on there alone; needs porta with --credential and a golemide
                   built on an Almide whose HTTP client honours HTTPS_PROXY (develop,
                   51b9d8e or later). by-name hands golemide the keys themselves
  ONOGORO_WRITABLE more directories commands and golemide may write, colon separated
                   (default: none). In a throwaway container, /usr:/var:/etc lets
                   pip and apt install as the task expects; not for a laptop.

With --model claude (or claude/MODEL), comide talks to claude -p on this machine's
login, and golemide reaches the same model through a bridge on 127.0.0.1 that only
this session's token opens: the login itself never goes inside.
"""

effect fn main() -> Unit = {
  let args = process.args()
  let code = if (env.get("ONOGORO_ROLE") ?? "") == "worker" then worker(list.drop(args, 1))!
    else if list.contains(args, "--help") and list.len(args) == 2 then { println(USAGE); 0 }
    else supervisor(args)!
  process.exit(code)
}

// ---- the supervisor ---------------------------------------------------------------------

effect fn supervisor(args: List[String]) -> Result[Int, String] = {
  let comide = found(env.get("ONOGORO_COMIDE") ?? "comide")!
  let porta = found(env.get("ONOGORO_PORTA") ?? "porta")!
  let me = found(list.first(args) ?? "onogoro")!
  let root = absolute(option_after(args, "--root") ?? ".")!
  broker_ready(porta)!
  let scratch = (string.strip_suffix(env.temp_dir(), "/") ?? env.temp_dir()) + "/onogoro-" + int.to_string(process.pid())
  fs.mkdir_p(scratch)!
  // What every worker is told. comide passes its environment to the runner it starts;
  // porta then starts each command from an empty one.
  env.set("ONOGORO_ROLE", "worker")
  env.set("ONOGORO_ROOT", root)
  env.set("ONOGORO_SCRATCH", scratch)
  env.set("ONOGORO_PORTA_BIN", porta)
  env.set("COMIDE_RUNNER", me)
  let bridge = match option.flat_map(option_after(args, "--model"), claude_model) {
    some(model) => some(claude_bridge(me, model, scratch)!),
    none => none,
  }
  let code = process.exec_attached(comide, list.drop(args, 1))!
  match bridge { some(b) => { let _ = process.exec("kill", [b.pid]) }, none => () }
  let _ = fs.remove_all(scratch)
  ok(code)
}

// Said once at the start rather than as a failed solve: a porta without --credential
// would refuse every golemide call the broker is asked for.
effect fn broker_ready(porta: String) -> Result[Unit, String] =
  if (env.get("ONOGORO_CREDENTIALS") ?? "broker") == "by-name" then ok(())
  else if string.contains(process.exec(porta, ["run", "--help"]) ?? "", "--credential") then ok(())
  else err("onogoro: " + porta + " has no --credential, which golemide's keys go in by (almide/porta#37); "
    + "use a porta built from develop, or ONOGORO_CREDENTIALS=by-name to hand the keys in by name")

// ---- Claude's login, from inside ------------------------------------------------------

// comide on `claude`, `claude/MODEL`, `claude:MODEL` or `cli/claude` talks to Claude Code's
// claude -p on this machine's login. golemide, confined, cannot: porta closes the
// Keychain the login is in. So the supervisor runs a bridge that golemide reaches with
// a URL and this session's token, and nothing else of the login goes in.
type Bridge = { pid: String, url: String, token: String }

// The model after `claude`, "default" when none is named.
fn claude_model(m: String) -> String? =
  if m == "claude" or m == "cli/claude" then some("default")
  else match string.strip_prefix(m, "claude/") {
    some(x) => some(x),
    none => string.strip_prefix(m, "claude:"),
  }

effect fn claude_bridge(me: String, model: String, scratch: String) -> Result[Bridge, String] = {
  let script = bridge_script(me)!
  let token = string.trim(process.exec("openssl", ["rand", "-hex", "16"]) ?? "")
  if token == "" then err("onogoro: could not make a token for the Claude bridge (openssl rand)")
  else {
    let port = int.to_string(20000 + process.pid() % 20000)
    let pid = string.trim(process.exec("sh", ["-c", "python3 \"$0\" --host 127.0.0.1 --port \"$1\" --token \"$2\" > \"$3\" 2>&1 & echo $!",
      script, port, token, scratch + "/claude-bridge.log"]) ?? "")
    let url = "http://127.0.0.1:" + port + "/v1"
    ready(url + "/models", 50)!
    env.set("CLAUDECLI_BASE_URL", url)
    env.set("CLAUDECLI_API_KEY", token)
    // solve follows the conversation onto Claude, unless the person chose its model.
    if option.is_none(env.get("COMIDE_SOLVE_MODEL")) then env.set("COMIDE_SOLVE_MODEL", "claudecli/" + model)
    ok(Bridge { pid: pid, url: url, token: token })
  }
}

// bridge/claude_bridge.py beside this binary's real path, or ONOGORO_BRIDGE.
effect fn bridge_script(me: String) -> Result[String, String] = {
  let real = string.trim(process.exec("realpath", [me]) ?? me)
  let beside = (string.strip_suffix(real, "/onogoro") ?? real) + "/bridge/claude_bridge.py"
  let script = env.get("ONOGORO_BRIDGE") ?? beside
  if fs.exists(script) then ok(script) else err("onogoro: the Claude bridge is not at " + script + " (ONOGORO_BRIDGE)")
}

// Up to `tries` tenths of a second for the bridge to answer.
effect fn ready(url: String, tries: Int) -> Result[Unit, String] = {
  var left = tries
  var up = false
  while not up and left > 0 {
    up = match process.exec_status("curl", ["-fsS", "-o", "/dev/null", url]) { ok(st) => st.code == 0, err(_) => false }
    if not up then { let _ = process.exec("sleep", ["0.1"]) }
    left = left - 1
  }
  if up then ok(()) else err("onogoro: the Claude bridge did not start (" + url + ")")
}

test "which models go through the bridge" {
  assert_eq(claude_model("claude"), some("default"))
  assert_eq(claude_model("claude/opus"), some("opus"))
  assert_eq(claude_model("claude:sonnet"), some("sonnet"))
  assert_eq(claude_model("cli/claude"), some("default"))
  assert_eq(claude_model("cf/glm-5.3-flash"), none)
  assert_eq(claude_model("claudecli/sonnet"), none)
}

// ---- a worker ---------------------------------------------------------------------------

// `KIND -- PROG ARGS...`, from comide's toolkit.run_in.
effect fn worker(args: List[String]) -> Result[Int, String] = {
  let kind = list.get(args, 0) ?? ""
  if list.get(args, 1) != some("--") or list.len(args) < 3 then err("onogoro worker: expected KIND -- PROG ARGS..., got " + string.join(args, " "))
  else {
    let w = world()!
    let porta = env.get("ONOGORO_PORTA_BIN") ?? "porta"
    process.exec_attached(porta, policy.invocation(w, kind, list.get(args, 2) ?? "", list.drop(args, 3)))
  }
}

effect fn world() -> Result[policy.World, String] = {
  let home = env.get("HOME") ?? ""
  let keys = match env.get("ONOGORO_KEYS") {
    some(k) => list.filter(list.map(string.split(k, ","), string.trim), (x) => x != ""),
    none => list.filter(policy.MODEL_KEYS, (k) => option.is_some(env.get(k))),
  }
  let uid = string.trim(process.exec("id", ["-u"]) ?? "")
  ok(policy.World {
    root: env.get("ONOGORO_ROOT") ?? ".",
    scratch: env.get("ONOGORO_SCRATCH") ?? env.temp_dir(),
    // The files golemide and comide read keys from, closed to every command.
    key_files: list.filter([home + "/.config/golemide/.env", home + "/.config/comide/.env"], (f) => fs.exists(f)),
    keys: keys,
    as_root: uid == "0",
    net: env.get("ONOGORO_NET") ?? "open",
    writable: list.filter(list.map(string.split(env.get("ONOGORO_WRITABLE") ?? "", ":"), string.trim), (d) => d != "" and fs.exists(d)),
    broker: (env.get("ONOGORO_CREDENTIALS") ?? "broker") != "by-name",
  })
}

// ---- small things -----------------------------------------------------------------------

// A program's absolute path: as given when it has a slash, else found on PATH.
effect fn found(prog: String) -> Result[String, String] =
  if string.contains(prog, "/") then absolute(prog)
  else match process.exec_status("sh", ["-c", "command -v " + prog]) {
    ok(st) => if st.code == 0 and string.trim(st.stdout) != "" then ok(string.trim(st.stdout)) else err(prog + " is not on PATH"),
    err(e) => err(e),
  }

effect fn absolute(p: String) -> Result[String, String] =
  if string.starts_with(p, "/") then ok(p)
  else {
    let cwd = env.cwd()!
    ok(if p == "." then cwd else cwd + "/" + (string.strip_prefix(p, "./") ?? p))
  }

fn option_after(args: List[String], name: String) -> String? =
  match list.find_index(args, (a) => a == name) {
    some(i) => list.get(args, i + 1),
    none => none,
  }
