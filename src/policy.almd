// What a worker may do, by what the call is for. comide names each command it runs
// (toolkit.run_in): `read` looks at the project, `shell` is a command the model wrote,
// `solve` is golemide, which edits and runs the verify command. Each becomes one
// `porta run`, and this is where the grants for it are decided.
//
// No key goes into a worker except to `solve`: golemide calls the model itself. With the
// broker (ONOGORO_CREDENTIALS=broker, porta with --credential, almide/porta#37) not even
// that one: golemide is handed a placeholder, and porta's proxy puts the real key on its
// requests to the model's host alone.

// Where the run is: the project, a scratch directory of this session's own, the files
// the keys are kept in (closed to reads), and whether porta runs as root (a container).
// `writable` is more a command and golemide may write, from ONOGORO_WRITABLE. On a laptop
// it is empty: a package goes into the project's own environment. In a container that is
// thrown away after the task it is where the system's packages go (/usr, /var, /etc),
// because there the files are not what needs keeping safe; the keys and the network are.
// `broker` says the keys go in as porta placeholders rather than by name.
type World = { root: String, scratch: String, key_files: List[String], keys: List[String], as_root: Bool, net: String,
  writable: List[String] = [], broker: Bool = false }

// The host each secret is good for, which is where porta's proxy may put it on. The
// account id is not a secret (it is in the URL), and the Claude bridge's URL and token
// are for a server on 127.0.0.1 that porta's proxy does not intercept: those go in by
// name either way.
let KEY_HOSTS = [
  ("CLOUDFLARE_API_TOKEN", "api.cloudflare.com"),
  ("ANTHROPIC_API_KEY", "api.anthropic.com"),
  ("OPENAI_API_KEY", "api.openai.com"),
  ("OPENROUTER_API_KEY", "openrouter.ai"),
  ("GEMINI_API_KEY", "generativelanguage.googleapis.com"),
  ("GOOGLE_API_KEY", "generativelanguage.googleapis.com"),
]

fn host_of(key: String) -> String? =
  option.map(list.find(KEY_HOSTS, (kh) => kh.0 == key), (kh) => kh.1)

// The variables golemide reads its models' credentials from. The last two are not keys:
// they are the supervisor's Claude bridge (bridge/claude_bridge.py), its URL and the
// session's token, which is all golemide holds when the model is Claude's login.
let MODEL_KEYS = ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN", "ANTHROPIC_API_KEY", "GEMINI_API_KEY",
  "GOOGLE_API_KEY", "OPENAI_API_KEY", "OPENROUTER_API_KEY", "CLAUDECLI_BASE_URL", "CLAUDECLI_API_KEY"]

// porta's flags for one call, everything between the command and `--`. TMPDIR is the
// scratch directory: without it a Rust program (golemide, hew) on macOS reaches for its
// per-user /var/folders directory, which porta closes (almide/porta#38).
fn grants(w: World, kind: String) -> List[String] =
  (if w.as_root then ["--allow-root"] else [])
    + ["-e", "TMPDIR=" + w.scratch]
    + writes(w, kind)
    + list.flat_map(w.key_files, (f) => ["--deny-read", f])
    + network(w, kind)
    + passed(w, kind)

// Looking writes nothing but its own scratch; a command and golemide write the project,
// and whatever else the session made writable.
fn writes(w: World, kind: String) -> List[String] =
  if kind == "read" then ["-v", w.scratch]
  else ["-v", w.root, "-v", w.scratch] + list.flat_map(w.writable, (d) => ["-v", d])

// Looking needs no network. A command gets what the session allows: open by default,
// because installing a package is ordinary work; `none` closes it.
fn network(w: World, kind: String) -> List[String] =
  if kind == "read" or w.net == "none" then ["--no-net"] else []

// What golemide is given of the keys: all by name, or with the broker each secret as a
// placeholder bound to its host, and the rest by name.
fn passed(w: World, kind: String) -> List[String] =
  if kind != "solve" or list.is_empty(w.keys) then []
  else if not w.broker then ["--env-pass", string.join(w.keys, ",")]
  else {
    let bound = list.filter(w.keys, (k) => option.is_some(host_of(k)))
    let named = list.filter(w.keys, (k) => option.is_none(host_of(k)))
    list.flat_map(bound, (k) => ["--credential", k + "=" + (host_of(k) ?? "")])
      + (if list.is_empty(named) then [] else ["--env-pass", string.join(named, ",")])
  }

// `porta run PROG GRANTS -- ARGS`: the whole invocation for one call.
fn invocation(w: World, kind: String, prog: String, args: List[String]) -> List[String] =
  ["run", prog] + grants(w, kind) + ["--"] + args

test "looking writes nothing, and reaches nothing" {
  let w = World { root: "/w/p", scratch: "/tmp/s", key_files: ["/h/.config/golemide/.env"], keys: ["CLOUDFLARE_API_TOKEN"], as_root: false, net: "open" }
  assert_eq(invocation(w, "read", "hew", ["tree", "/w/p"]),
    ["run", "hew", "-e", "TMPDIR=/tmp/s", "-v", "/tmp/s", "--deny-read", "/h/.config/golemide/.env", "--no-net", "--", "tree", "/w/p"])
}

test "a command writes the project, and no key goes in with it" {
  let w = World { root: "/w/p", scratch: "/tmp/s", key_files: [], keys: ["CLOUDFLARE_API_TOKEN"], as_root: true, net: "open" }
  let g = grants(w, "shell")
  assert_eq(g, ["--allow-root", "-e", "TMPDIR=/tmp/s", "-v", "/w/p", "-v", "/tmp/s"])
  assert(not list.contains(g, "--env-pass"))
  assert(list.contains(grants({ ...w, net: "none" }, "shell"), "--no-net"))
}

test "what the session makes writable goes to commands and golemide, not to looking" {
  let w = World { root: "/w/p", scratch: "/tmp/s", key_files: [], keys: [], as_root: true, net: "open", writable: ["/usr", "/var"] }
  assert_eq(writes(w, "shell"), ["-v", "/w/p", "-v", "/tmp/s", "-v", "/usr", "-v", "/var"])
  assert_eq(writes(w, "solve"), ["-v", "/w/p", "-v", "/tmp/s", "-v", "/usr", "-v", "/var"])
  assert_eq(writes(w, "read"), ["-v", "/tmp/s"])
}

test "with the broker, golemide gets placeholders bound to hosts, and the rest by name" {
  let w = World { root: "/w/p", scratch: "/tmp/s", key_files: [], keys: ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN", "ANTHROPIC_API_KEY"],
    as_root: false, net: "open", broker: true }
  assert_eq(passed(w, "solve"), ["--credential", "CLOUDFLARE_API_TOKEN=api.cloudflare.com", "--credential", "ANTHROPIC_API_KEY=api.anthropic.com",
    "--env-pass", "CLOUDFLARE_ACCOUNT_ID"])
  assert_eq(passed(w, "shell"), ([]: List[String]))
  assert_eq(passed({ ...w, keys: ["CLAUDECLI_BASE_URL", "CLAUDECLI_API_KEY"] }, "solve"), ["--env-pass", "CLAUDECLI_BASE_URL,CLAUDECLI_API_KEY"])
}

test "golemide alone is given the model keys, by name" {
  let w = World { root: "/w/p", scratch: "/tmp/s", key_files: [], keys: ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"], as_root: false, net: "open" }
  assert_eq(passed(w, "solve"), ["--env-pass", "CLOUDFLARE_ACCOUNT_ID,CLOUDFLARE_API_TOKEN"])
  assert_eq(passed(w, "shell"), ([]: List[String]))
  assert_eq(passed({ ...w, keys: ([]: List[String]) }, "solve"), ([]: List[String]))
}
